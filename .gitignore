# CreativeSync .gitignore

# Python Byte Code & Caches
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/
.ruff_cache/

# Virtual Environments
.venv/
venv/
ENV/
env/
env.bak/
venv.bak/

# Environment Files & API Keys (CRITICAL SECURITY)
.env
.env.*
!.env.example
*.env
*.pem
*.key
*.p12
*.pfx
secrets/
config/keys/

# Vector Database & Local Data Storage
chroma_db/
*.db
*.sqlite3

# IDEs & Editors
.vscode/
.idea/
*.swp
*.swo

# OS Generated Files
.DS_Store
Thumbs.db
desktop.ini
